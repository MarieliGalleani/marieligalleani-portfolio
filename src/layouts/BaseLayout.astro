---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { site } from '@/config/site';
import { useTranslations, langs, locales, localizePath, stripLang, defaultLang, type Lang } from '@/i18n/ui';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative path to the OG image. */
  image?: string;
  type?: 'website' | 'article';
  lang?: Lang;
  /** Emit hreflang alternates (disable on pages that only exist in one language, e.g. 404). */
  alternates?: boolean;
}

const { title, description, image = site.ogImage, type = 'website', lang = defaultLang, alternates = true } = Astro.props;
const t = useTranslations(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const basePath = stripLang(Astro.url.pathname);
const alternateLinks = langs.map((l) => ({
  hreflang: locales[l].hreflang,
  href: new URL(localizePath(l, basePath), Astro.site).href,
}));
---

<!doctype html>
<html lang={locales[lang].hreflang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates && alternateLinks.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {alternates && <link rel="alternate" hreflang="x-default" href={alternateLinks[0].href} />}
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#faf8f5" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111014" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locales[lang].og} />
    {alternates && langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={locales[l].og} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!--
      Analytics placeholder — uncomment and fill in ONE provider.
      Plausible (privacy-friendly, no cookie banner needed):
      <script defer data-domain="marieligalleani.com.br" src="https://plausible.io/js/script.js"></script>

      Google Analytics 4:
      <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-XXXXXXXXXX');
      </script>
    -->

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Header lang={lang} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
