---
import Icon from './Icon.astro';
import BookButton from './BookButton.astro';
import { agency } from '@/data/agency';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const s = agency[lang].services;
---

<section id="services" class="section" aria-labelledby="services-title">
  <div class="container">
    <header class="section__header">
      <p class="badge">{s.badge}</p>
      <h2 id="services-title" class="section__title" set:html={s.title} />
      <p class="section__lead">{s.lead}</p>
    </header>

    <ul role="list" class="bento">
      {s.items.map((item, i) => (
        <li class:list={['card', 'card--hover', 'svc', 'reveal', { 'svc--wide': item.wide, 'svc--hero': i === 0 }]}>
          <span class="icon-tile"><Icon name={item.icon} /></span>
          <h3 class="svc__name">{item.name}</h3>
          <p class="svc__desc">{item.description}</p>
          <ul role="list" class="svc__list">
            {item.bullets.map((b) => (
              <li><Icon name="check" />{b}</li>
            ))}
          </ul>
        </li>
      ))}
    </ul>

    <div class="section__cta">
      <BookButton lang={lang} />
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    gap: var(--space-4);
  }

  .svc {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-6);
  }

  .svc--hero {
    background:
      radial-gradient(80% 90% at 100% 0%, var(--color-accent-soft), transparent 70%),
      var(--color-surface-raised);
  }

  .svc__name {
    margin-top: var(--space-2);
    font-size: var(--text-xl);
  }

  .svc__desc {
    color: var(--color-text-muted);
  }

  .svc__list {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-2);
    font-size: var(--text-sm);
  }

  .svc__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .svc__list :global(svg) {
    flex-shrink: 0;
    width: var(--space-4);
    height: var(--space-4);
    margin-top: var(--space-1);
    color: var(--color-accent);
  }

  @media (min-width: 48rem) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .bento {
      grid-template-columns: repeat(3, 1fr);
    }

    .svc--wide {
      grid-column: span 2;
    }

    .svc--wide .svc__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
