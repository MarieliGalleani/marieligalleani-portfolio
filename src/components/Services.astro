---
import BookButton from './BookButton.astro';
import { services } from '@/data/services';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section id="services" class="section" aria-labelledby="services-title">
  <div class="container">
    <header class="section__header section__header--split">
      <p class="section__index"><span>01</span> {t('services.eyebrow')}</p>
      <h2 id="services-title" class="section__title">{t('services.title')}</h2>
      <p class="section__lead">{t('services.lead')}</p>
    </header>

    <ol role="list" class="svc-list">
      {services[lang].map((s, i) => (
        <li class:list={['svc', 'reveal', { 'svc--featured': s.featured }]}>
          <p class="svc__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <div class="svc__head">
            {s.featured && <p class="svc__badge">{t('services.popular')}</p>}
            <h3 class="svc__name">{s.name}</h3>
            <p class="svc__tagline">{s.tagline}</p>
          </div>
          <dl class="svc__meta">
            <div>
              <dt>{t('services.for')}</dt>
              <dd>{s.forWho}</dd>
            </div>
            <div>
              <dt>{t('services.deliverables')}</dt>
              <dd>
                <ul class="svc__list">
                  {s.deliverables.map((d) => <li>{d}</li>)}
                </ul>
              </dd>
            </div>
          </dl>
          <div class="svc__side">
            <p class="svc__timeline"><span>{t('services.timeline')}</span> {s.timeline}</p>
            <p class="svc__price"><span>{t('services.from')}</span> {s.priceFrom}</p>
            <BookButton variant={s.featured ? 'primary' : 'secondary'} size="small" lang={lang} />
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .svc-list {
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .svc {
    display: grid;
    gap: var(--space-5);
    padding-block: var(--space-7);
    border-top: var(--border-width) solid var(--color-border);
    transition: background-color var(--duration-base) var(--ease-out);
  }

  .svc__index {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .svc__head {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .svc__badge {
    justify-self: start;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .svc__name {
    font-size: var(--text-2xl);
  }

  .svc--featured .svc__name {
    font-style: italic;
  }

  .svc__tagline {
    color: var(--color-text-muted);
  }

  .svc__meta {
    display: grid;
    gap: var(--space-5);
    font-size: var(--text-sm);
  }

  .svc__meta dt,
  .svc__side span {
    display: block;
    margin-bottom: var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .svc__meta dd {
    margin: 0;
  }

  .svc__list {
    display: grid;
    gap: var(--space-1);
    padding-left: var(--space-4);
  }

  .svc__list li::marker {
    color: var(--color-accent);
  }

  .svc__side {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    justify-items: start;
  }

  .svc__timeline {
    font-size: var(--text-sm);
  }

  .svc__price {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
  }

  @media (min-width: 64rem) {
    .svc {
      grid-template-columns: var(--space-8) 1.2fr 1.4fr calc(var(--space-10) + var(--space-8));
      gap: var(--space-7);
    }

    .svc:hover {
      background: var(--color-surface);
    }
  }
</style>
