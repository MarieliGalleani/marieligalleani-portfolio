---
import { agency } from '@/data/agency';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const p = agency[lang].process;
---

<section id="process" class="section section--surface" aria-labelledby="process-title">
  <div class="container">
    <header class="section__header">
      <p class="badge">{p.badge}</p>
      <h2 id="process-title" class="section__title" set:html={p.title} />
      <p class="section__lead">{p.lead}</p>
    </header>
    <ol role="list" class="steps">
      {p.steps.map((step, i) => (
        <li class="step reveal">
          <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="card step__body">
            <span class="step__when">{step.when}</span>
            <h3 class="step__name">{step.name}</h3>
            <p class="step__desc">{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .steps {
    display: grid;
    gap: var(--space-4);
    counter-reset: none;
  }

  /* Timeline: numbered markers joined by a line, a card under each. */
  .step {
    position: relative;
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .step__body {
    display: grid;
    flex: 1;
    gap: var(--space-3);
    align-content: start;
    height: 100%;
    padding: var(--space-6);
  }

  .step__num {
    display: grid;
    place-items: center;
    width: var(--size-touch);
    height: var(--size-touch);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: var(--weight-bold);
    box-shadow: 0 0 0 var(--space-2) var(--color-accent-soft);
  }

  .step__when {
    justify-self: start;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .step__name {
    font-size: var(--text-xl);
  }

  .step__desc {
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }

    .step {
      grid-template-rows: auto 1fr;
    }

    .step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: calc(var(--size-touch) / 2);
      left: calc(var(--size-touch) + var(--space-3));
      right: calc(var(--space-3) - var(--space-4));
      border-top: calc(var(--border-width) * 2) dashed var(--color-border-strong);
    }

    .step:first-child::after {
      border-top-style: solid;
      border-top-color: var(--color-accent);
    }
  }
</style>
