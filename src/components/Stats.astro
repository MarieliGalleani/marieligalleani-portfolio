---
import { agency } from '@/data/agency';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const s = agency[lang].stats;
---

<section class="section" aria-labelledby="stats-title">
  <div class="container">
    <div class="stats-box inverse reveal">
      <header class="section__header section__header--left stats-box__header">
        <p class="badge">{s.badge}</p>
        <h2 id="stats-title" class="section__title" set:html={s.title} />
        <p class="section__lead">{s.lead}</p>
      </header>
      <ul role="list" class="stats">
        {s.items.map((item) => (
          <li class="stat">
            <p class="stat__value">{item.value}</p>
            <p class="stat__label">{item.label}</p>
            <p class="stat__source">{item.source}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  /* One dark container, same language as the hero frame. */
  .stats-box {
    display: grid;
    gap: var(--space-7);
    padding: var(--space-7) var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  .stats-box__header {
    margin: 0;
  }

  .stats {
    display: grid;
    border-top: var(--border-width) solid var(--color-border);
  }

  .stat {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    padding: var(--space-5) 0;
  }

  .stat + .stat {
    border-top: var(--border-width) solid var(--color-border);
  }

  .stat__value {
    font-size: var(--text-4xl);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-accent);
  }

  .stat__label {
    font-size: var(--text-lg);
  }

  .stat__source {
    margin-top: auto;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .stats-box {
      padding: var(--space-8);
    }

    .stats {
      grid-template-columns: repeat(3, 1fr);
    }

    .stat {
      padding: var(--space-6) var(--space-6) 0;
    }

    .stat:first-child {
      padding-left: 0;
    }

    .stat + .stat {
      border-top: 0;
      border-left: var(--border-width) solid var(--color-border);
    }
  }
</style>
