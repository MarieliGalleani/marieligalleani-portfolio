---
/**
 * Animated dotted world map: routes from client HQs (North America, Europe, Israel) to the
 * São Paulo hub, then out to the Latin American markets. Pure SVG + CSS, no JavaScript.
 * Geometry comes from scripts/generate-world-map.mjs (src/data/world-map.json + world-dots.svg).
 */
import world from '@/data/world-map.json';
import { agency } from '@/data/agency';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const m = agency[lang].hero.map;
const { width, height, points } = world;
type Point = { x: number; y: number; kind: string };
const pts = points as Record<string, Point>;
const hub = pts.saopaulo;

/** Quadratic arc between two points, bowed "upwards" (towards smaller y). */
function arc(a: Point, b: Point, bend = 0.28) {
  const mx = (a.x + b.x) / 2;
  const my = (a.y + b.y) / 2;
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  let nx = -dy;
  let ny = dx;
  if (ny > 0) {
    nx = -nx;
    ny = -ny;
  }
  const len = Math.hypot(nx, ny) || 1;
  const k = Math.hypot(dx, dy) * bend;
  const cx = mx + (nx / len) * k;
  const cy = my + (ny / len) * k;
  return `M${a.x} ${a.y}Q${cx.toFixed(2)} ${cy.toFixed(2)} ${b.x} ${b.y}`;
}

const origins = Object.entries(pts).filter(([, p]) => p.kind === 'origin');
const markets = Object.entries(pts).filter(([, p]) => p.kind === 'market');
const routes = [
  ...origins.map(([id, p]) => ({ id, d: arc(p, hub), kind: 'in' })),
  ...markets.map(([id, p]) => ({ id, d: arc(hub, p, 0.22), kind: 'out' })),
];

// Local payment rails shown under each city: signals we know how people actually pay there.
const rails: Record<string, string> = {
  saopaulo: 'Pix · Boleto · WhatsApp',
  mexico: 'OXXO · SPEI',
  bogota: 'PSE · Nequi',
  lima: 'Yape',
  santiago: 'Webpay',
  buenosaires: 'Mercado Pago',
};

// Label placement around the pin (keeps the Andes labels off each other).
const side: Record<string, string> = {
  sf: 'left',
  london: 'left',
  mexico: 'right',
  bogota: 'left',
  lima: 'left',
  santiago: 'left',
  buenosaires: 'below',
  saopaulo: 'right',
};
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(2)}%`;
---

<div
  class="world"
  role="img"
  aria-label={m.label}
  style={`--ratio: ${width} / ${height}; --hub-x: ${pct(hub.x, width)}; --hub-y: ${pct(hub.y, height)};`}
>
  <div class="world__dots" aria-hidden="true"></div>
  <svg class="world__routes" viewBox={`0 0 ${width} ${height}`} aria-hidden="true">
    <g class="world__base">
      {routes.map((r) => <path d={r.d} pathLength="1" />)}
    </g>
    <g class="world__comets">
      {routes.map((r, i) => (
        <path class={`world__comet world__comet--${r.kind}`} d={r.d} pathLength="1" style={`--i: ${i}`} />
      ))}
    </g>
    {Object.values(pts).map((p, i) => (
      <g class={`world__pin world__pin--${p.kind}`} style={`--i: ${i}`}>
        {p.kind === 'hub' && (
          <>
            <circle class="world__radar" cx={p.x} cy={p.y} r="3" />
            <circle class="world__radar world__radar--outer" cx={p.x} cy={p.y} r="6" />
            <circle class="world__ping world__ping--late" cx={p.x} cy={p.y} r="0.6" />
          </>
        )}
        <circle class="world__ping" cx={p.x} cy={p.y} r="0.6" />
        <circle class="world__core" cx={p.x} cy={p.y} r={p.kind === 'hub' ? 0.9 : 0.55} />
      </g>
    ))}
  </svg>
  {Object.entries(m.cities).map(([id, name]) => {
    const p = pts[id];
    return p ? (
      <span
        class={`world__label world__label--${p.kind} world__label--${side[id] ?? 'right'}`}
        style={`left: ${pct(p.x, width)}; top: ${pct(p.y, height)};`}
        aria-hidden="true"
      >
        <span class="world__city">{name}</span>
        {rails[id] && <span class="world__rails">{rails[id]}</span>}
      </span>
    ) : null;
  })}
</div>
<ul role="list" class="world__legend" aria-hidden="true">
  <li class="world__key world__key--origin">{m.legend.origin}</li>
  <li class="world__key world__key--hub">{m.legend.hub}</li>
  <li class="world__key world__key--market">{m.legend.market}</li>
</ul>

<style>
  .world {
    position: relative;
    width: 100%;
    aspect-ratio: var(--ratio);
  }

  /* Land dots: the SVG is a mask, so the color comes from tokens. Latin America glows. */
  .world__dots {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at var(--hub-x) var(--hub-y), var(--color-accent), transparent 22%),
      var(--map-dot);
    mask: url('/media/world-dots.svg') center / 100% 100% no-repeat;
    -webkit-mask: url('/media/world-dots.svg') center / 100% 100% no-repeat;
  }

  .world__routes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .world__base path {
    fill: none;
    stroke: var(--color-accent);
    stroke-opacity: 0.22;
    stroke-width: var(--border-width);
    vector-effect: non-scaling-stroke;
  }

  .world__comet {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: calc(var(--border-width) * 2);
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: var(--route-dash) 1;
    stroke-dashoffset: var(--route-dash);
    filter: drop-shadow(0 0 var(--space-1) var(--color-accent));
    opacity: 0;
  }

  .world__core {
    fill: var(--color-text-muted);
  }

  .world__pin--hub .world__core,
  .world__pin--market .world__core {
    fill: var(--color-accent);
  }

  .world__pin--hub .world__core {
    stroke: var(--color-bg);
    stroke-width: 0.3;
  }

  .world__ping {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 0.15;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  .world__radar {
    fill: var(--color-accent);
    fill-opacity: 0.06;
    stroke: var(--color-accent);
    stroke-opacity: 0.35;
    stroke-width: var(--border-width);
    stroke-dasharray: 2 3;
    vector-effect: non-scaling-stroke;
  }

  .world__radar--outer {
    fill: none;
    stroke-opacity: 0.18;
  }

  .world__label {
    position: absolute;
    display: grid;
    padding: var(--space-1) var(--space-2);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
    white-space: nowrap;
    translate: var(--space-3) -50%;
  }

  .world__city {
    font-weight: var(--weight-medium);
  }

  .world__rails {
    color: var(--color-accent);
    font-size: var(--text-xs);
  }

  .world__label--hub .world__rails {
    color: var(--color-on-accent);
  }

  .world__label--left {
    translate: calc(-100% - var(--space-3)) -50%;
  }

  .world__label--below {
    translate: -50% var(--space-3);
  }

  .world__label--hub {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: var(--weight-semibold);
  }

  .world__label--market {
    color: var(--color-text);
  }

  /* Small screens: only the hub label, the rest is too dense to read. */
  .world__label:not(.world__label--hub) {
    display: none;
  }

  @media (min-width: 48rem) {
    .world__label:not(.world__label--hub) {
      display: grid;
    }
  }

  .world__legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .world__key {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .world__key::before {
    content: '';
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-text-muted);
  }

  .world__key--hub::before {
    width: var(--space-3);
    height: var(--space-3);
    background: var(--color-accent);
  }

  .world__key--market::before {
    background: var(--color-accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .world__comet {
      animation: route var(--route-duration) var(--ease-out) infinite;
      animation-delay: calc(var(--i) * var(--route-stagger));
    }

    .world__pin--hub .world__ping,
    .world__pin--market .world__ping {
      animation: ping var(--pulse-duration) var(--ease-out) infinite;
      animation-delay: calc(var(--i) * var(--route-stagger));
    }

    .world__pin--hub .world__ping--late {
      animation-delay: calc(var(--i) * var(--route-stagger) + var(--pulse-duration) / 2);
    }

    .world__radar--outer {
      transform-box: fill-box;
      transform-origin: center;
      animation: spin calc(var(--marquee-duration)) linear infinite;
    }

    @keyframes spin {
      to {
        transform: rotate(1turn);
      }
    }

    @keyframes route {
      0% {
        stroke-dashoffset: var(--route-dash);
        opacity: 1;
      }

      70% {
        opacity: 1;
      }

      100% {
        stroke-dashoffset: -1;
        opacity: 0;
      }
    }

    @keyframes ping {
      0% {
        opacity: 0.9;
        transform: scale(1);
      }

      100% {
        opacity: 0;
        transform: scale(4);
      }
    }
  }

  /* Without motion, show the routes as solid lines instead. */
  @media (prefers-reduced-motion: reduce) {
    .world__base path {
      stroke-opacity: 0.5;
    }
  }
</style>
