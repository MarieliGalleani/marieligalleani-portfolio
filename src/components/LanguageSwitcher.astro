---
import { languages, langs, localizePath, stripLang, locales, useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
// Same page in the other languages (slugs are shared across locales).
// Pages that only exist in English (404) link to each language's home instead.
const basePath = Astro.url.pathname.startsWith('/404') ? '/' : stripLang(Astro.url.pathname);
---

<nav class="lang" aria-label={t('nav.language')}>
  <ul role="list">
    {langs.map((l) => (
      <li>
        <a
          href={localizePath(l, basePath)}
          hreflang={locales[l].hreflang}
          lang={locales[l].hreflang}
          aria-current={l === lang ? 'page' : undefined}
        >
          <span aria-hidden="true">{l.toUpperCase()}</span>
          <span class="visually-hidden">{languages[l]}</span>
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .lang ul {
    display: flex;
  }

  .lang a {
    display: inline-grid;
    place-items: center;
    min-width: var(--size-touch);
    min-height: var(--size-touch);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
    border-radius: var(--radius-md);
  }

  .lang a:hover {
    color: var(--color-text);
  }

  .lang a[aria-current="page"] {
    color: var(--color-accent);
    text-decoration: underline;
  }
</style>
