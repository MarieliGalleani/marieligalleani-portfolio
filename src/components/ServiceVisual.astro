---
/**
 * Small decorative UI illustrations for the wide service cards (CSS only, aria-hidden).
 * roadmap  — the service's own bullets as a go-to-market timeline
 * video    — a video editor frame with a moving playhead
 * localize — the same call to action in EN, PT-BR and ES-MX with local payment rails
 */
import Icon from './Icon.astro';

interface Props {
  kind: 'roadmap' | 'video' | 'localize';
  steps?: string[];
}

const { kind, steps = [] } = Astro.props;
const locales = [
  { code: 'EN', cta: 'Get started', rails: ['Card'] },
  { code: 'PT-BR', cta: 'Começar agora', rails: ['Pix', 'Boleto', '12x'] },
  { code: 'ES-MX', cta: 'Empieza ahora', rails: ['OXXO', 'SPEI'] },
];
---

<div class={`viz viz--${kind}`} aria-hidden="true">
  {kind === 'roadmap' && (
    <ol class="road">
      {steps.map((step, i) => (
        <li class:list={['road__step', { 'road__step--done': i < 2, 'road__step--now': i === 2 }]}>
          <span class="road__dot">{i < 2 ? <Icon name="check" /> : String(i + 1).padStart(2, '0')}</span>
          <span class="road__label">{step}</span>
        </li>
      ))}
    </ol>
  )}

  {kind === 'video' && (
    <div class="vid inverse">
      <span class="vid__rec">REC 00:14</span>
      <span class="vid__play"><Icon name="play" /></span>
      <div class="vid__timeline">
        <span class="vid__clip"></span>
        <span class="vid__clip vid__clip--b"></span>
        <span class="vid__clip vid__clip--c"></span>
        <span class="vid__head"></span>
      </div>
    </div>
  )}

  {kind === 'localize' && (
    <ul role="list" class="loc">
      {locales.map((l) => (
        <li class="loc__row">
          <span class="loc__code">{l.code}</span>
          <span class="loc__cta">{l.cta}</span>
          <span class="loc__rails">
            {l.rails.map((r) => <span class="loc__rail">{r}</span>)}
          </span>
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  .viz {
    display: grid;
    align-content: center;
    min-height: 100%;
    padding: var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  /* Roadmap */
  .road {
    position: relative;
    display: grid;
    gap: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .road::before {
    content: '';
    position: absolute;
    top: var(--space-4);
    bottom: var(--space-4);
    left: calc(var(--space-4) - var(--border-width));
    border-left: calc(var(--border-width) * 2) dashed var(--color-border-strong);
  }

  .road__step {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3) var(--space-2) 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .road__dot {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--space-6);
    height: var(--space-6);
    border: var(--border-width) solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background: var(--color-surface-raised);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .road__dot :global(svg) {
    width: var(--space-4);
    height: var(--space-4);
  }

  .road__label {
    flex: 1;
    padding: var(--space-2) var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
  }

  .road__step--done {
    color: var(--color-text);
  }

  .road__step--done .road__dot {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .road__step--now .road__dot {
    border-color: var(--color-accent);
    color: var(--color-accent);
    box-shadow: 0 0 0 var(--space-1) var(--color-accent-soft);
  }

  .road__step--now .road__label {
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  /* Video frame */
  .viz--video {
    padding: 0;
    border: 0;
    background: none;
  }

  .vid {
    display: grid;
    place-items: center;
    min-height: 13rem;
    border-radius: var(--radius-lg);
  }

  .vid::after {
    display: none;
  }

  .vid__rec {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .vid__rec::before {
    content: '';
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
  }

  .vid__play {
    display: grid;
    place-items: center;
    width: var(--space-8);
    height: var(--space-8);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-on-accent);
    box-shadow: var(--shadow-accent);
  }

  .vid__timeline {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    left: var(--space-3);
    display: flex;
    gap: var(--space-1);
    height: var(--space-5);
    padding: var(--space-1);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }

  .vid__clip {
    flex: 3;
    border-radius: var(--radius-sm);
    background: var(--color-accent-soft);
    border: var(--border-width) solid var(--color-accent);
  }

  .vid__clip--b {
    flex: 2;
  }

  .vid__clip--c {
    flex: 4;
  }

  .vid__head {
    position: absolute;
    top: calc(var(--space-1) * -1);
    bottom: calc(var(--space-1) * -1);
    left: 30%;
    width: calc(var(--border-width) * 2);
    background: var(--color-text);
  }

  /* Localized CTA rows */
  .loc {
    display: grid;
    gap: var(--space-3);
  }

  .loc__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    font-size: var(--text-sm);
  }

  .loc__code {
    min-width: var(--space-8);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .loc__cta {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: var(--weight-semibold);
  }

  .loc__rails {
    display: flex;
    gap: var(--space-1);
    margin-left: auto;
  }

  .loc__rail {
    padding: 0 var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  @media (prefers-reduced-motion: no-preference) {
    .vid__head {
      animation: scrub calc(var(--route-duration) * 2) linear infinite;
    }

    @keyframes scrub {
      from {
        left: var(--space-1);
      }

      to {
        left: calc(100% - var(--space-1));
      }
    }
  }
</style>
