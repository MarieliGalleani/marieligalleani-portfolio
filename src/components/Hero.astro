---
import BookButton from './BookButton.astro';
import Icon from './Icon.astro';
import Markets from './Markets.astro';
import { agency } from '@/data/agency';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const h = agency[lang].hero;
---

<section class="hero inverse" aria-labelledby="hero-title">
  <div class="container hero__inner">
    <p class="badge hero__badge">{h.badge}</p>
    <h1 id="hero-title" class="hero__title" set:html={h.title} />
    <p class="hero__subtitle">{h.subtitle}</p>
    <div class="btn-group hero__ctas">
      <BookButton lang={lang} label={h.primary} />
      <a class="btn btn--secondary hero__secondary" href="#process">{h.secondary}</a>
    </div>
    <ul role="list" class="hero__trust">
      {h.trust.map((item) => (
        <li><Icon name="check" />{item}</li>
      ))}
    </ul>

    <figure class="panel" aria-label={`${h.panel.title} — ${h.panel.note}`}>
      <div class="panel__bar" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="panel__body">
        <div class="panel__col">
          <p class="panel__title">{h.panel.title}</p>
          <p class="panel__subtitle">{h.panel.subtitle}</p>
          <ul role="list" class="panel__markets">
            {h.panel.markets.map((m) => (
              <li class={`panel__market panel__market--${m.state}`}>
                <span class="panel__flag"><Icon name="globe" /></span>
                <span class="panel__market-name">{m.name}</span>
                <span class="panel__status">{m.status}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="panel__col">
          <p class="panel__title">{h.panel.checklistTitle}</p>
          <ul role="list" class="panel__checklist">
            {h.panel.checklist.map((c) => (
              <li class:list={['panel__task', { 'panel__task--done': c.done }]}>
                <span class="panel__check"><Icon name={c.done ? 'check' : 'clock'} /></span>
                {c.label}
              </li>
            ))}
          </ul>
        </div>
      </div>
      <figcaption class="panel__note">{h.panel.note}</figcaption>
    </figure>
  </div>
  <Markets lang={lang} />
</section>

<style>
  .hero {
    padding-block: var(--space-9) var(--space-7);
  }

  .hero__inner {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    text-align: center;
  }

  .hero__title {
    max-width: var(--measure-headline);
    font-size: var(--text-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .hero__subtitle {
    max-width: var(--measure);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .hero__ctas {
    justify-content: center;
    margin-top: var(--space-2);
  }

  .hero__secondary {
    background: transparent;
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .hero__trust :global(svg) {
    width: var(--space-4);
    height: var(--space-4);
    color: var(--color-accent);
  }

  /* Illustrative product panel */
  .panel {
    width: 100%;
    max-width: var(--container-narrow);
    margin-top: var(--space-7);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg), 0 0 0 var(--space-2) var(--color-accent-soft);
    text-align: left;
  }

  .panel__bar {
    display: flex;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .panel__bar span {
    width: var(--space-3);
    height: var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-border);
  }

  .panel__body {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-5);
  }

  .panel__col {
    display: grid;
    align-content: start;
    gap: var(--space-3);
  }

  .panel__title {
    font-weight: var(--weight-semibold);
  }

  .panel__subtitle {
    margin-top: calc(var(--space-3) * -1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .panel__markets,
  .panel__checklist {
    display: grid;
    gap: var(--space-2);
  }

  .panel__market {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    font-size: var(--text-sm);
  }

  .panel__flag :global(svg) {
    width: var(--space-5);
    height: var(--space-5);
    color: var(--color-text-muted);
  }

  .panel__market-name {
    flex: 1;
    font-weight: var(--weight-medium);
  }

  .panel__status {
    padding: 0 var(--space-2);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    background: var(--color-surface);
  }

  .panel__market--live .panel__status {
    color: var(--color-on-accent);
    background: var(--color-accent);
  }

  .panel__market--launching .panel__status {
    color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .panel__task {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .panel__task--done {
    color: var(--color-text);
  }

  .panel__check {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--space-5);
    height: var(--space-5);
    border-radius: var(--radius-pill);
    background: var(--color-surface-raised);
    color: var(--color-text-muted);
  }

  .panel__task--done .panel__check {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .panel__check :global(svg) {
    width: var(--space-3);
    height: var(--space-3);
  }

  .panel__note {
    padding: 0 var(--space-5) var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .panel__body {
      grid-template-columns: 1fr 1.2fr;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__inner > * {
      animation: rise var(--duration-slow) var(--ease-out) both;
    }

    .panel {
      animation-delay: var(--duration-base);
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(var(--space-5));
      }
    }
  }
</style>
