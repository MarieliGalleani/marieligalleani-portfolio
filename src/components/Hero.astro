---
import BookButton from './BookButton.astro';
import Icon from './Icon.astro';
import Markets from './Markets.astro';
import WorldMap from './WorldMap.astro';
import { agency } from '@/data/agency';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const h = agency[lang].hero;
---

<section class="hero inverse" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero__frame">
      <div class="hero__content">
        <p class="badge hero__badge">{h.badge}</p>
        <h1 id="hero-title" class="hero__title" set:html={h.title} />
        <p class="hero__subtitle">{h.subtitle}</p>
        <div class="btn-group hero__ctas">
          <BookButton lang={lang} label={h.primary} />
          <a class="btn btn--secondary hero__secondary" href="#process">{h.secondary}</a>
        </div>
        <ul role="list" class="hero__trust">
          {h.trust.map((item) => (
            <li><Icon name="check" />{item}</li>
          ))}
        </ul>
      </div>

      <figure class="stage">
        <div class="stage__map">
          <WorldMap lang={lang} />
        </div>

        <div class="panel panel--plan">
          <p class="panel__title">{h.panel.title}</p>
          <p class="panel__subtitle">{h.panel.subtitle}</p>
          <ul role="list" class="panel__markets">
            {h.panel.markets.map((m) => (
              <li class={`panel__market panel__market--${m.state}`}>
                <span class="panel__flag"><Icon name="globe" /></span>
                <span class="panel__market-name">{m.name}</span>
                <span class="panel__status">{m.status}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="panel panel--tasks">
          <p class="panel__title">{h.panel.checklistTitle}</p>
          <ul role="list" class="panel__checklist">
            {h.panel.checklist.map((c) => (
              <li class:list={['panel__task', { 'panel__task--done': c.done }]}>
                <span class="panel__check"><Icon name={c.done ? 'check' : 'clock'} /></span>
                {c.label}
              </li>
            ))}
          </ul>
        </div>
        <figcaption class="stage__note">{h.panel.note}</figcaption>
      </figure>
    </div>
  </div>
  <Markets lang={lang} />
</section>

<style>
  .hero {
    padding-block: var(--space-4) var(--space-7);
  }

  /* Main container: a rounded frame whose background is the world map. */
  .hero__frame {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: var(--space-8) var(--space-4) var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(70% 60% at 50% 0%, var(--glow-1), transparent 70%),
      radial-gradient(45% 45% at 35% 85%, var(--inverse-accent-soft), transparent 70%),
      var(--color-surface);
    box-shadow: var(--shadow-lg);
  }

  .hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    text-align: center;
  }

  .hero__title {
    max-width: var(--measure-headline);
    font-size: var(--text-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .hero__subtitle {
    max-width: var(--measure);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .hero__ctas {
    justify-content: center;
    margin-top: var(--space-2);
  }

  .hero__secondary {
    background: transparent;
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2) var(--space-5);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .hero__trust li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .hero__trust :global(svg) {
    width: var(--space-4);
    height: var(--space-4);
    color: var(--color-accent);
  }

  /* Map stage with floating launch-plan cards (illustrative) */
  .stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    width: 100%;
    margin-top: var(--space-6);
  }

  .stage__map {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    overflow: hidden;
  }

  /* Small screens: zoom into the Americas and Europe, where the routes are. */
  @media (max-width: 47.99rem) {
    .stage__map :global(.world) {
      width: 170%;
      margin-left: -12%;
    }
  }

  .stage__note {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
  }

  .panel {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-translucent);
    backdrop-filter: blur(var(--blur-md));
    -webkit-backdrop-filter: blur(var(--blur-md));
    box-shadow: var(--shadow-lg);
    text-align: left;
  }

  @media (min-width: 48rem) {
    .stage {
      grid-template-columns: 1fr 1fr;
    }

    .stage__map,
    .stage__note {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .hero__frame {
      padding: var(--space-9) var(--space-6) var(--space-5);
    }

    .stage {
      display: block;
      /* The map rises behind the headline and fades in from the top. */
      margin-top: calc(var(--space-9) * -1);
    }

    .stage__map {
      mask-image: linear-gradient(to bottom, transparent, black 30%);
      -webkit-mask-image: linear-gradient(to bottom, transparent, black 30%);
    }

    /* Cards float over the empty oceans, clear of the routes and labels. */
    .panel {
      position: absolute;
      bottom: var(--space-8);
      width: 21%;
    }

    .panel--plan {
      right: 0;
    }

    .panel--tasks {
      left: 0;
    }

    .panel--plan .panel__market {
      padding-block: var(--space-2);
    }

    .stage__note {
      margin-top: var(--space-3);
    }
  }

  .panel__title {
    font-weight: var(--weight-semibold);
  }

  .panel__subtitle {
    margin-top: calc(var(--space-2) * -1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .panel__markets,
  .panel__checklist {
    display: grid;
    gap: var(--space-2);
  }

  .panel__market {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
    font-size: var(--text-sm);
  }

  .panel__flag :global(svg) {
    width: var(--space-5);
    height: var(--space-5);
    color: var(--color-text-muted);
  }

  .panel__market-name {
    flex: 1;
    font-weight: var(--weight-medium);
  }

  .panel__status {
    padding: 0 var(--space-2);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    background: var(--color-surface);
  }

  .panel__market--live .panel__status {
    color: var(--color-on-accent);
    background: var(--color-accent);
  }

  .panel__market--launching .panel__status {
    color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .panel__task {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .panel__task--done {
    color: var(--color-text);
  }

  .panel__check {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: var(--space-5);
    height: var(--space-5);
    border-radius: var(--radius-pill);
    background: var(--color-surface-raised);
    color: var(--color-text-muted);
  }

  .panel__task--done .panel__check {
    background: var(--color-accent);
    color: var(--color-on-accent);
  }

  .panel__check :global(svg) {
    width: var(--space-3);
    height: var(--space-3);
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__content > *,
    .stage {
      animation: rise var(--duration-slow) var(--ease-out) both;
    }

    .stage {
      animation-delay: var(--duration-base);
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(var(--space-5));
      }
    }
  }
</style>
