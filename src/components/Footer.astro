---
import { site } from '@/config/site';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
const [first, ...rest] = site.name.split(' ');
const links = [
  { href: site.social.linkedin, label: 'LinkedIn', external: true },
  { href: site.social.github, label: 'GitHub', external: true },
  { href: site.social.dribbble, label: 'Dribbble', external: true },
  { href: `mailto:${site.email}`, label: site.email, external: false },
];
---

<footer class="footer">
  <div class="container footer__inner">
    <p class="footer__wordmark" aria-hidden="true">{first} <em>{rest.join(' ')}</em></p>
    <div class="footer__row">
      <p class="footer__brand">{site.name} — {site.role}</p>
      <nav aria-label={t('a11y.social')}>
        <ul role="list" class="footer__links">
          {links.map((l) => (
            <li>
              <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener me' } : {})}>
                {l.label}
                {l.external && <span class="visually-hidden">{t('a11y.newTab')}</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <p class="footer__copy">© {year} · {t('footer.rights')}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-9) var(--space-6);
    border-top: var(--border-width) solid var(--color-border);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    overflow: hidden;
  }

  .footer__inner {
    display: grid;
    gap: var(--space-7);
  }

  .footer__wordmark {
    font-family: var(--font-serif);
    font-size: var(--text-display);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-text);
    white-space: nowrap;
  }

  .footer__wordmark em {
    font-style: italic;
    color: var(--color-accent);
  }

  .footer__row {
    display: grid;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: var(--border-width) solid var(--color-border);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
  }

  .footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch);
    color: var(--color-text);
    text-decoration: none;
  }

  .footer__links a:hover {
    color: var(--color-accent);
  }

  @media (min-width: 64rem) {
    .footer__row {
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
    }

    .footer__copy {
      text-align: right;
    }
  }
</style>
