---
import { site } from '@/config/site';
import { agency } from '@/data/agency';
import { useTranslations, localizePath, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const a = agency[lang];
const home = localizePath(lang, '/');
const year = new Date().getFullYear();
const serviceLinks = a.services.items.slice(0, 6).map((s) => ({ href: `${home}#services`, label: s.name }));
const companyLinks = [
  { href: `${home}#process`, label: t('nav.process') },
  { href: `${home}#work`, label: t('nav.work') },
  { href: `${home}#pricing`, label: t('nav.pricing') },
  { href: `${home}#about`, label: t('nav.about') },
  { href: `${home}#faq`, label: t('nav.faq') },
];
const contactLinks = [
  { href: `mailto:${site.email}`, label: site.email, external: false },
  { href: site.bookingUrl, label: t('cta.book'), external: true },
  { href: site.social.linkedin, label: 'LinkedIn', external: true },
  ...(site.whatsapp ? [{ href: `https://wa.me/${site.whatsapp}`, label: 'WhatsApp', external: true }] : []),
];
---

<footer class="footer inverse">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <p class="footer__name">{site.name}</p>
        <p class="footer__tagline">{a.footer.tagline}</p>
        <p class="footer__markets"><strong>{a.footer.markets}:</strong> {a.markets.items.join(' · ')}</p>
      </div>
      <nav class="footer__col" aria-label={a.footer.services}>
        <p class="footer__heading">{a.footer.services}</p>
        <ul role="list">{serviceLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <nav class="footer__col" aria-label={a.footer.company}>
        <p class="footer__heading">{a.footer.company}</p>
        <ul role="list">{companyLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
      <nav class="footer__col" aria-label={a.footer.contact}>
        <p class="footer__heading">{a.footer.contact}</p>
        <ul role="list">
          {contactLinks.map((l) => (
            <li>
              <a href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>
                {l.label}
                {l.external && <span class="visually-hidden">{t('a11y.newTab')}</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
    <p class="footer__copy">© {year} {site.name} · {site.founder}. {t('footer.rights')}</p>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--space-9) var(--space-6);
    font-size: var(--text-sm);
  }

  .footer__top {
    display: grid;
    gap: var(--space-7);
    padding-bottom: var(--space-7);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .footer__brand {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    max-width: var(--measure-short);
  }

  .footer__name {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
  }

  .footer__tagline,
  .footer__markets {
    color: var(--color-text-muted);
  }

  .footer__markets strong {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  .footer__heading {
    margin-bottom: var(--space-3);
    font-weight: var(--weight-semibold);
  }

  .footer__col ul {
    display: grid;
    gap: var(--space-1);
  }

  .footer__col a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer__col a:hover {
    color: var(--color-accent);
  }

  .footer__copy {
    padding-top: var(--space-5);
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .footer__top {
      grid-template-columns: 1.5fr repeat(3, 1fr);
    }
  }
</style>
