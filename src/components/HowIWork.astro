---
import BookButton from './BookButton.astro';
import { processSteps } from '@/data/process';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section id="process" class="section section--surface" aria-labelledby="process-title">
  <div class="container">
    <header class="section__header">
      <p class="eyebrow">{t('process.eyebrow')}</p>
      <h2 id="process-title" class="section__title">{t('process.title')}</h2>
    </header>

    <ol role="list" class="steps">
      {processSteps[lang].map((step, i) => (
        <li class="step">
          <span class="step__number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="step__name">{step.name}</h3>
          <p class="step__desc">{step.description}</p>
        </li>
      ))}
    </ol>

    <div class="section__cta">
      <BookButton lang={lang} />
    </div>
  </div>
</section>

<style>
  .steps {
    display: grid;
    gap: var(--space-6);
  }

  .step {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border-strong);
  }

  .step__number {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
  }

  .step__name {
    font-size: var(--text-xl);
  }

  .step__desc {
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
