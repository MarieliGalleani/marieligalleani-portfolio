---
import CaseCard from './CaseCard.astro';
import { agency } from '@/data/agency';
import type { Lang } from '@/i18n/ui';
import { getCases } from '@/lib/cases';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const w = agency[lang].work;
// Real products with mockups first; the placeholder case is left out of the home page.
const cases = (await getCases(lang)).filter((c) => c.data.video || c.data.gallery.length > 0);
---

<section id="work" class="section" aria-labelledby="work-title">
  <div class="container">
    <header class="section__header">
      <p class="badge">{w.badge}</p>
      <h2 id="work-title" class="section__title" set:html={w.title} />
      <p class="section__lead">{w.lead}</p>
    </header>
    <ul role="list" class="work-grid">
      {cases.map((entry, i) => (
        <li class:list={{ 'work-grid__wide': i === 0 }}>
          <CaseCard entry={entry} lang={lang} eager={i === 0} />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .work-grid {
    display: grid;
    gap: var(--space-4);
  }

  .work-grid > li {
    display: flex;
  }

  .work-grid > li > :global(*) {
    flex: 1;
  }

  @media (min-width: 48rem) {
    .work-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .work-grid__wide {
      grid-column: 1 / -1;
    }
  }

  /* Featured case: media left, text right, so it doesn't dominate the page. */
  @media (min-width: 64rem) {
    .work-grid__wide :global(.case) {
      display: grid;
      grid-template-columns: 1.6fr 1fr;
    }

    .work-grid__wide :global(.case__media img) {
      height: 100%;
    }

    .work-grid__wide :global(.case__body) {
      justify-content: center;
      padding: var(--space-7);
    }

    .work-grid__wide :global(.case__title) {
      font-size: var(--text-2xl);
    }
  }
</style>
