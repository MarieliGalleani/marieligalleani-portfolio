---
import BookButton from './BookButton.astro';
import { site } from '@/config/site';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations, localizePath, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const home = localizePath(lang, '/');
const links = [
  { href: `${home}#services`, label: t('nav.services') },
  { href: `${home}#work`, label: t('nav.work') },
  { href: `${home}#process`, label: t('nav.process') },
  { href: `${home}#about`, label: t('nav.about') },
];
---

<header class="header">
  <div class="container header__inner">
    <a class="header__logo" href={home} aria-label={`${site.name} — ${t('a11y.home')}`}>
      <span aria-hidden="true" class="header__mark">MG</span>
      <span class="header__name">{site.name}</span>
    </a>
    <nav class="header__nav" aria-label={t('nav.main')}>
      <ul role="list">
        {links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="header__actions">
      <LanguageSwitcher lang={lang} />
      <BookButton size="small" lang={lang} label={t('cta.bookShort')} />
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg-translucent);
    backdrop-filter: blur(var(--blur-md));
    -webkit-backdrop-filter: blur(var(--blur-md));
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--size-touch);
    color: var(--color-text);
    font-weight: var(--weight-bold);
    text-decoration: none;
  }

  .header__mark {
    display: grid;
    place-items: center;
    width: var(--size-touch);
    height: var(--size-touch);
    background: var(--color-accent);
    color: var(--color-on-accent);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-normal);
  }

  .header__name {
    display: none;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .header__nav {
    display: none;
  }

  .header__nav ul {
    display: flex;
    gap: var(--space-1);
  }

  .header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch);
    padding-inline: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
    border-radius: var(--radius-md);
  }

  .header__nav a:hover {
    color: var(--color-text);
  }

  @media (min-width: 48rem) {
    .header__name {
      display: inline;
    }
  }

  @media (min-width: 64rem) {
    .header__nav {
      display: block;
    }
  }
</style>
