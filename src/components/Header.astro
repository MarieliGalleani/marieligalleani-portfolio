---
import BookButton from './BookButton.astro';
import { site } from '@/config/site';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { useTranslations, localizePath, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const home = localizePath(lang, '/');
const [first, ...rest] = site.name.split(' ');
const links = [
  { href: `${home}#services`, label: t('nav.services') },
  { href: `${home}#work`, label: t('nav.work') },
  { href: `${home}#process`, label: t('nav.process') },
  { href: `${home}#about`, label: t('nav.about') },
];
---

<header class="header">
  <div class="container header__inner">
    <a class="header__logo" href={home} aria-label={`${site.name} — ${t('a11y.home')}`}>
      <span aria-hidden="true">{first} <em>{rest.join(' ')}</em></span>
    </a>
    <nav class="header__nav" aria-label={t('nav.main')}>
      <ul role="list">
        {links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="header__actions">
      <p class="header__status"><span class="header__dot" aria-hidden="true"></span>{t('nav.available')}</p>
      <LanguageSwitcher lang={lang} />
      <BookButton size="small" lang={lang} label={t('cta.bookShort')} />
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg-translucent);
    backdrop-filter: blur(var(--blur-md)) saturate(1.4);
    -webkit-backdrop-filter: blur(var(--blur-md)) saturate(1.4);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    white-space: nowrap;
    text-decoration: none;
  }

  .header__logo em {
    font-style: italic;
    color: var(--color-accent);
  }

  .header__logo:hover {
    color: var(--color-text);
  }

  .header__nav {
    display: none;
  }

  .header__nav ul {
    display: flex;
    gap: var(--space-2);
  }

  .header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch);
    padding-inline: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .header__nav a:hover {
    color: var(--color-text);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .header__status {
    display: none;
    align-items: center;
    gap: var(--space-2);
    margin-right: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .header__dot {
    width: var(--space-2);
    height: var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--color-success);
    box-shadow: 0 0 0 var(--space-1) var(--color-accent-soft);
  }

  @media (max-width: 29.99rem) {
    .header__logo {
      font-size: var(--text-lg);
    }
  }

  @media (min-width: 64rem) {
    .header__nav {
      display: block;
    }
  }

  @media (min-width: 80rem) {
    .header__status {
      display: inline-flex;
    }
  }
</style>
