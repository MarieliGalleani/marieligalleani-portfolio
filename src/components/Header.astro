---
import BookButton from './BookButton.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { site } from '@/config/site';
import { useTranslations, localizePath, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const home = localizePath(lang, '/');
const links = [
  { href: `${home}#services`, label: t('nav.services') },
  { href: `${home}#process`, label: t('nav.process') },
  { href: `${home}#work`, label: t('nav.work') },
  { href: `${home}#pricing`, label: t('nav.pricing') },
  { href: `${home}#faq`, label: t('nav.faq') },
];
---

<header class="header inverse">
  <div class="container header__inner">
    <a class="header__logo" href={home} aria-label={`${site.name} — ${t('a11y.home')}`}>
      <span class="header__mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" width="32" height="32"><rect width="32" height="32" rx="9" fill="currentColor"/><path d="M21.5 11.2A7 7 0 1 0 23 16h-6.5" fill="none" stroke="var(--color-bg)" stroke-width="3" stroke-linecap="round"/></svg>
      </span>
      <span class="header__name" aria-hidden="true">{site.name}</span>
    </a>
    <nav class="header__nav" aria-label={t('nav.main')}>
      <ul role="list">
        {links.map((l) => (
          <li>
            <a href={l.href}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="header__actions">
      <LanguageSwitcher lang={lang} />
      <BookButton size="small" lang={lang} label={t('cta.bookShort')} />
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    overflow: visible;
    background: var(--color-bg);
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .header::before,
  .header::after {
    display: none;
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--size-touch);
    font-size: var(--text-lg);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    text-decoration: none;
  }

  .header__mark {
    color: var(--color-accent);
  }

  .header__logo:hover {
    color: var(--color-text);
  }

  .header__nav {
    display: none;
  }

  .header__nav ul {
    display: flex;
    gap: var(--space-1);
  }

  .header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch);
    padding-inline: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .header__nav a:hover {
    color: var(--color-text);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  @media (min-width: 64rem) {
    .header__nav {
      display: block;
    }
  }
</style>
