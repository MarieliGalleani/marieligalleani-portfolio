---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { useTranslations, localizePath, type Lang } from '@/i18n/ui';
import { caseSlug } from '@/lib/cases';

interface Props {
  entry: CollectionEntry<'cases'>;
  lang?: Lang;
  index?: number;
  /** Load the first card eagerly (above the fold on some screens). */
  eager?: boolean;
}

const { entry, lang = 'en', index = 0, eager = false } = Astro.props;
const t = useTranslations(lang);
const { title, client, outcome, tags, cover, coverAlt, video } = entry.data;
const href = localizePath(lang, `/work/${caseSlug(entry)}/`);
const flip = index % 2 === 1;
---

<article class:list={['case', 'reveal', { 'case--flip': flip }]}>
  <a class="case__media frame" href={href} tabindex="-1" aria-hidden="true">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 64rem) 52rem, 100vw"
      loading={eager ? 'eager' : 'lazy'}
    />
    {video && <span class="case__play">▶ {t('case.watch')}</span>}
  </a>
  <div class="case__body">
    <p class="case__index"><span>{String(index + 1).padStart(2, '0')}</span> {client}</p>
    <h3 class="case__title">
      <a href={href}>{title}</a>
    </h3>
    <p class="case__outcome">{outcome}</p>
    <ul class="tags" aria-label={t('a11y.tags')}>
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
    <p class="case__more" aria-hidden="true">{t('work.readCase')} <span>→</span></p>
  </div>
</article>

<style>
  .case {
    position: relative;
    display: grid;
    gap: var(--space-6);
    align-items: center;
  }

  .case__media {
    position: relative;
    display: block;
  }

  .case__media img {
    width: 100%;
    height: auto;
    aspect-ratio: var(--ratio-cover);
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .case:hover .case__media img,
  .case:focus-within .case__media img {
    transform: scale(var(--scale-hover));
  }

  .case__play {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-pill);
    background: var(--color-bg-translucent);
    color: var(--color-text);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    backdrop-filter: blur(var(--blur-md));
    -webkit-backdrop-filter: blur(var(--blur-md));
  }

  .case__body {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .case__index {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .case__index span {
    font-family: var(--font-mono);
    color: var(--color-accent);
  }

  .case__title {
    font-size: var(--text-2xl);
  }

  .case__title a {
    text-decoration: none;
  }

  /* Whole row is clickable through the title link. */
  .case__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .case__title a:focus-visible {
    box-shadow: none;
  }

  .case:has(a:focus-visible) {
    border-radius: var(--radius-lg);
    box-shadow: var(--focus-ring);
  }

  .case__outcome {
    max-width: var(--measure-short);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    color: var(--color-accent);
  }

  .case__more {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
  }

  .case__more span {
    display: inline-block;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .case:hover .case__more span {
    transform: translateX(var(--space-2));
  }

  @media (min-width: 64rem) {
    .case {
      grid-template-columns: 7fr 5fr;
      gap: var(--space-8);
    }

    .case--flip {
      grid-template-columns: 5fr 7fr;
    }

    .case--flip .case__media {
      order: 2;
    }
  }
</style>
