---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
import { useTranslations, localizePath, type Lang } from '@/i18n/ui';
import { caseSlug } from '@/lib/cases';

interface Props {
  entry: CollectionEntry<'cases'>;
  lang?: Lang;
  /** Load the first card eagerly (above the fold on some screens). */
  eager?: boolean;
}

const { entry, lang = 'en', eager = false } = Astro.props;
const t = useTranslations(lang);
const { title, client, outcome, tags, cover, coverAlt, video } = entry.data;
const href = localizePath(lang, `/work/${caseSlug(entry)}/`);
---

<article class="card card--hover case reveal">
  <div class="case__media">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[640, 960, 1280, 1600]}
      sizes="(min-width: 76rem) 76rem, (min-width: 48rem) 50vw, 100vw"
      loading={eager ? 'eager' : 'lazy'}
    />
    {video && <span class="case__play"><Icon name="camera" />{t('case.watch')}</span>}
  </div>
  <div class="case__body">
    <p class="eyebrow">{client}</p>
    <h3 class="case__title"><a href={href}>{title}</a></h3>
    <p class="case__outcome">{outcome}</p>
    <ul class="tags" aria-label={t('a11y.tags')}>
      {tags.map((tag) => <li class="tag">{tag}</li>)}
    </ul>
    <p class="case__more" aria-hidden="true">{t('work.readCase')} <Icon name="arrow" /></p>
  </div>
</article>

<style>
  .case {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .case__media {
    position: relative;
    overflow: hidden;
    background: var(--color-surface);
  }

  .case__media img {
    width: 100%;
    height: auto;
    aspect-ratio: var(--ratio-cover);
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  .case:hover .case__media img {
    transform: scale(var(--scale-hover));
  }

  .case__play {
    position: absolute;
    left: var(--space-4);
    bottom: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-bg-translucent);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    backdrop-filter: blur(var(--blur-md));
    -webkit-backdrop-filter: blur(var(--blur-md));
  }

  .case__play :global(svg) {
    width: var(--space-4);
    height: var(--space-4);
  }

  .case__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-6) var(--space-6);
    flex: 1;
  }

  .case__title {
    font-size: var(--text-xl);
  }

  .case__title a {
    text-decoration: none;
  }

  .case__title a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .case__title a:focus-visible {
    box-shadow: none;
  }

  .case:has(a:focus-visible) {
    box-shadow: var(--focus-ring);
  }

  .case__outcome {
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
  }

  .case__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .case__more :global(svg) {
    width: var(--space-4);
    height: var(--space-4);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .case:hover .case__more :global(svg) {
    transform: translateX(var(--space-1));
  }
</style>
