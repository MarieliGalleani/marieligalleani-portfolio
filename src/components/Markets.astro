---
/** Infinite marquee of the markets we launch in. CSS-only; still under reduced motion. */
import { agency } from '@/data/agency';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const m = agency[lang].markets;
---

<div class="markets">
  <p class="markets__label">{m.label}</p>
  <div class="markets__viewport">
    <ul role="list" class="markets__track">
      {[0, 1].map((copy) =>
        m.items.map((name) => (
          <li aria-hidden={copy === 1 ? 'true' : undefined}>{name}</li>
        )),
      )}
    </ul>
  </div>
</div>

<style>
  .markets {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-9);
    text-align: center;
  }

  .markets__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .markets__viewport {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 15%, black 85%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 15%, black 85%, transparent);
  }

  .markets__track {
    display: flex;
    gap: var(--space-8);
    width: max-content;
    animation: marquee var(--marquee-duration) linear infinite;
  }

  .markets:hover .markets__track {
    animation-play-state: paused;
  }

  .markets__track li {
    font-size: var(--text-2xl);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  @keyframes marquee {
    to {
      transform: translateX(calc(-50% - var(--space-8) / 2));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .markets__track {
      flex-wrap: wrap;
      justify-content: center;
      width: auto;
      animation: none;
    }

    .markets__track li[aria-hidden="true"] {
      display: none;
    }
  }
</style>
