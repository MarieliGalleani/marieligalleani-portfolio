---
import Icon from './Icon.astro';
import BookButton from './BookButton.astro';
import { agency } from '@/data/agency';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const p = agency[lang].pricing;
const t = useTranslations(lang);
---

<section id="pricing" class="section section--surface" aria-labelledby="pricing-title">
  <div class="container">
    <header class="section__header">
      <p class="badge">{p.badge}</p>
      <h2 id="pricing-title" class="section__title" set:html={p.title} />
      <p class="section__lead">{p.lead}</p>
    </header>
    <ul role="list" class="plans">
      {p.plans.map((plan) => (
        <li class:list={['card', 'plan', 'reveal', { 'plan--featured inverse': plan.featured }]}>
          <div class="plan__head">
            <h3 class="plan__name">{plan.name}</h3>
            {plan.featured && <span class="plan__popular">{p.popular}</span>}
          </div>
          <p class="plan__for">{plan.forWho}</p>
          <p class="plan__price">
            <span class="plan__from">{t('services.from')}</span>
            <strong>{plan.price}</strong>
            <span class="plan__period">{plan.period}</span>
          </p>
          <BookButton variant={plan.featured ? 'primary' : 'secondary'} lang={lang} label={p.cta} />
          <ul role="list" class="plan__features">
            {plan.features.map((f) => (
              <li><Icon name="check" />{f}</li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
    <p class="plans__note">{p.note}</p>
  </div>
</section>

<style>
  .plans {
    display: grid;
    gap: var(--space-4);
    align-items: stretch;
  }

  .plan {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: var(--space-6);
  }

  .plan--featured {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-lg);
  }

  .plan__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .plan__name {
    font-size: var(--text-xl);
  }

  .plan__popular {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
  }

  .plan__for {
    color: var(--color-text-muted);
  }

  .plan__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
  }

  .plan__price strong {
    font-size: var(--text-3xl);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-display);
  }

  .plan__from,
  .plan__period {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .plan__features {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border);
    font-size: var(--text-sm);
  }

  .plan__features li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .plan__features :global(svg) {
    flex-shrink: 0;
    width: var(--space-4);
    height: var(--space-4);
    margin-top: var(--space-1);
    color: var(--color-accent);
  }

  .plans__note {
    margin-top: var(--space-5);
    text-align: center;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (min-width: 64rem) {
    .plans {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
