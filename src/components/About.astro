---
import Icon from './Icon.astro';
import { agency } from '@/data/agency';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const a = agency[lang].about;
---

<section id="about" class="section" aria-labelledby="about-title">
  <div class="container about">
    <div class="about__text">
      <p class="badge">{a.badge}</p>
      <h2 id="about-title" class="section__title" set:html={a.title} />
      {a.paragraphs.map((p) => <p class="about__p">{p}</p>)}
    </div>
    <ul role="list" class="about__points">
      {a.points.map((pt) => (
        <li class="card about__point reveal">
          <span class="icon-tile"><Icon name="check" /></span>
          <div>
            <h3 class="about__name">{pt.name}</h3>
            <p class="about__desc">{pt.description}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  .about__text {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .about__p {
    max-width: var(--measure);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .about__points {
    display: grid;
    gap: var(--space-3);
  }

  .about__point {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    padding: var(--space-5);
    border-radius: var(--radius-lg);
  }

  .about__name {
    font-size: var(--text-lg);
  }

  .about__desc {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (min-width: 64rem) {
    .about {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-9);
    }
  }
</style>
