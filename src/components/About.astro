---
import BookButton from './BookButton.astro';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const t = useTranslations(lang);
---

<section id="about" class="section section--surface" aria-labelledby="about-title">
  <div class="container">
    <header class="section__header">
      <p class="section__index"><span>04</span> {t('about.eyebrow')}</p>
      <h2 id="about-title" class="visually-hidden">{t('about.title')}</h2>
    </header>

    <div class="about">
      <p class="about__statement reveal">{t('about.p1')}</p>
      <div class="about__body">
        <p>{t('about.p2')}</p>
        <p set:html={t('about.p3')} />
        <dl class="about__facts">
          <div><dt>{t('about.basedLabel')}</dt><dd>{t('about.basedValue')}</dd></div>
          <div><dt>{t('about.overlapLabel')}</dt><dd>{t('about.overlapValue')}</dd></div>
          <div><dt>{t('about.langsLabel')}</dt><dd>{t('about.langsValue')}</dd></div>
        </dl>
        <BookButton lang={lang} />
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: var(--space-8);
  }

  .about__statement {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    text-wrap: balance;
  }

  .about__body {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    max-width: var(--measure);
    color: var(--color-text-muted);
  }

  .about__body :global(strong) {
    color: var(--color-text);
    font-weight: var(--weight-medium);
  }

  .about__facts {
    width: 100%;
    margin-block: var(--space-3);
    border-top: var(--border-width) solid var(--color-border-strong);
  }

  .about__facts div {
    display: grid;
    grid-template-columns: var(--space-10) 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: var(--border-width) solid var(--color-border);
    font-size: var(--text-sm);
  }

  .about__facts dt {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .about__facts dd {
    margin: 0;
    color: var(--color-text);
  }

  @media (min-width: 64rem) {
    .about {
      grid-template-columns: 1.3fr 1fr;
      gap: var(--space-9);
    }
  }
</style>
