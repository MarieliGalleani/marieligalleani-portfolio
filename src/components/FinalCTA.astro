---
import BookButton from './BookButton.astro';
import { site } from '@/config/site';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
  title?: string;
}

const { lang = 'en', title } = Astro.props;
const t = useTranslations(lang);
---

<section class="final-cta" aria-labelledby="final-cta-title">
  <div class="container final-cta__inner">
    <p class="section__index"><span>→</span> {t('cta.book')}</p>
    <h2 id="final-cta-title" class="final-cta__title reveal" set:html={title ?? t('final.title')} />
    <div class="final-cta__row">
      <p class="final-cta__lead">{t('final.lead')}</p>
      <div class="final-cta__actions">
        <BookButton lang={lang} />
        <p class="final-cta__sub">
          {t('cta.bookSub')}<br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding-block: var(--space-section);
    background: var(--color-surface);
  }

  .final-cta__inner {
    display: grid;
    gap: var(--space-7);
  }

  .final-cta__title {
    max-width: var(--measure-headline);
    font-size: var(--text-4xl);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .final-cta__row {
    display: grid;
    gap: var(--space-6);
    padding-top: var(--space-6);
    border-top: var(--border-width) solid var(--color-border);
  }

  .final-cta__lead {
    max-width: var(--measure);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .final-cta__actions {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .final-cta__sub {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (min-width: 64rem) {
    .final-cta__row {
      grid-template-columns: 1.2fr 1fr;
      gap: var(--space-9);
    }

    .final-cta__actions {
      justify-items: end;
      text-align: right;
    }
  }
</style>
