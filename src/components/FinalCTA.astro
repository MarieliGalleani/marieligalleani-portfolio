---
import BookButton from './BookButton.astro';
import { agency } from '@/data/agency';
import { site } from '@/config/site';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
  title?: string;
}

const { lang = 'en', title } = Astro.props;
const c = agency[lang].cta;
---

<section class="final" aria-labelledby="final-cta-title">
  <div class="container">
    <div class="final__box inverse">
      <h2 id="final-cta-title" class="final__title" set:html={title ?? c.title} />
      <p class="final__lead">{c.lead}</p>
      <BookButton lang={lang} label={c.primary} />
      <p class="final__note">
        {c.note} · <a href={`mailto:${site.email}`}>{site.email}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .final {
    padding-block: var(--space-section);
  }

  .final__box {
    display: grid;
    justify-items: center;
    gap: var(--space-5);
    padding: var(--space-9) var(--space-5);
    border-radius: var(--radius-xl);
    text-align: center;
  }

  .final__title {
    max-width: var(--measure-headline);
    font-size: var(--text-4xl);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .final__lead {
    max-width: var(--measure);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .final__note {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .final__note a {
    color: var(--color-text);
  }
</style>
