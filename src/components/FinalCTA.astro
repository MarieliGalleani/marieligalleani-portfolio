---
import BookButton from './BookButton.astro';
import { site } from '@/config/site';
import { useTranslations, type Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
  title?: string;
}

const { lang = 'en', title } = Astro.props;
const t = useTranslations(lang);
---

<section class="section final-cta" aria-labelledby="final-cta-title">
  <div class="container">
    <div class="final-cta__box">
      <h2 id="final-cta-title" class="final-cta__title">{title ?? t('final.title')}</h2>
      <p class="final-cta__lead">{t('final.lead')}</p>
      <div class="final-cta__actions">
        <BookButton lang={lang} />
        <p class="final-cta__sub">
          {t('cta.bookSub')} · <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta__box {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    padding: var(--space-7) var(--space-5);
    background: var(--color-accent-soft);
    border-radius: var(--radius-lg);
  }

  .final-cta__title {
    max-width: var(--container-narrow);
    font-size: var(--text-3xl);
  }

  .final-cta__lead {
    max-width: var(--measure);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .final-cta__actions {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .final-cta__sub {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .final-cta__box {
      padding: var(--space-8);
    }
  }
</style>
