---
import { testimonials } from '@/data/testimonials';
import { agency } from '@/data/agency';
import type { Lang } from '@/i18n/ui';

interface Props {
  lang?: Lang;
}

const { lang = 'en' } = Astro.props;
const h = agency[lang].testimonials;
---

<section id="testimonials" class="section section--surface" aria-labelledby="testimonials-title">
  <div class="container">
    <header class="section__header">
      <p class="badge">{h.badge}</p>
      <h2 id="testimonials-title" class="section__title" set:html={h.title} />
    </header>
    <ul role="list" class="quotes">
      {testimonials[lang].map((item) => (
        <li class="card quote reveal">
          <figure>
            <p class="quote__stars" aria-hidden="true">★★★★★</p>
            <blockquote class="quote__text"><p>{item.quote}</p></blockquote>
            <figcaption class="quote__author">
              <span class="quote__avatar" aria-hidden="true">{item.name.split(' ').map((n) => n[0]).join('').slice(0, 2)}</span>
              <span>
                <strong>{item.name}</strong>
                <span class="quote__role">{item.role}, {item.company}</span>
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .quotes {
    display: grid;
    gap: var(--space-4);
  }

  .quote {
    padding: var(--space-6);
  }

  .quote figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    height: 100%;
  }

  .quote__stars {
    color: var(--color-accent);
    letter-spacing: var(--tracking-wide);
  }

  .quote__text {
    font-size: var(--text-lg);
  }

  .quote__author {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: auto;
    font-size: var(--text-sm);
  }

  .quote__avatar {
    display: grid;
    place-items: center;
    width: var(--size-touch);
    height: var(--size-touch);
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-weight: var(--weight-bold);
  }

  .quote__role {
    display: block;
    color: var(--color-text-muted);
  }

  @media (min-width: 64rem) {
    .quotes {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
