---
import { Image, getImage } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import FinalCTA from '@/components/FinalCTA.astro';
import ShowcaseVideo from '@/components/ShowcaseVideo.astro';
import { site } from '@/config/site';
import { useTranslations, localizePath, type Lang } from '@/i18n/ui';
import { caseSlug } from '@/lib/cases';

interface Props {
  entry: CollectionEntry<'cases'>;
  next: CollectionEntry<'cases'>;
  lang: Lang;
}

const { entry, next, lang } = Astro.props;
const { Content } = await render(entry);
const t = useTranslations(lang);
const { title, client, role, timeline, tools, summary, outcome, tags, cover, coverAlt, video, gallery, repo } = entry.data;
const ogImage = await getImage({ src: cover, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
const showNext = next.id !== entry.id;
---

<BaseLayout title={`${title} — ${site.name}`} description={summary} image={ogImage.src} type="article" lang={lang}>
  <article class="case">
    <header class="case__header">
      <div class="container container--narrow case__intro">
        <a class="case__back" href={`${localizePath(lang, '/')}#work`}>← {t('case.back')}</a>
        <ul class="tags" aria-label={t('a11y.tags')}>
          {tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
        <h1 class="case__title">{title}</h1>
        <p class="case__summary">{summary}</p>
      </div>

      <div class="container">
        {video ? (
          <ShowcaseVideo {...video} lang={lang} />
        ) : (
        <Image
          class="case__cover"
          src={cover}
          alt={coverAlt}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 72rem) 72rem, 100vw"
          loading="eager"
          fetchpriority="high"
        />
        )}
      </div>

      <div class="container container--narrow">
        <dl class="case__meta">
          <div>
            <dt>{t('case.client')}</dt>
            <dd>{client}</dd>
          </div>
          <div>
            <dt>{t('case.role')}</dt>
            <dd>{role}</dd>
          </div>
          <div>
            <dt>{t('case.timeline')}</dt>
            <dd>{timeline}</dd>
          </div>
          <div>
            <dt>{t('case.tools')}</dt>
            <dd>{tools.join(', ')}</dd>
          </div>
        </dl>
        {repo && (
          <p class="case__repo">
            <a href={repo} target="_blank" rel="noopener">
              {t('case.repo')} <span aria-hidden="true">↗</span>
              <span class="visually-hidden">{t('a11y.newTab')}</span>
            </a>
          </p>
        )}

        <div class="case__outcome">
          <p class="eyebrow">{t('case.outcome')}</p>
          <p class="case__outcome-value">{outcome}</p>
        </div>
      </div>
    </header>

    <div class="container container--narrow prose">
      <Content />
    </div>

    {gallery.length > 0 && (
      <section class="container gallery" aria-labelledby="gallery-title">
        <h2 id="gallery-title" class="gallery__title">{t('case.gallery')}</h2>
        <ul role="list" class="gallery__grid">
          {gallery.map((g, i) => (
            <li class:list={['gallery__item', { 'gallery__item--wide': i === 0 }]}>
              <Image
                src={g.src}
                alt={g.alt}
                widths={[640, 960, 1280, 1600]}
                sizes={i === 0 ? '(min-width: 72rem) 72rem, 100vw' : '(min-width: 48rem) 36rem, 100vw'}
                loading="lazy"
              />
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>

  {showNext && (
    <nav class="container container--narrow next-case" aria-label={t('case.next')}>
      <a class="card next-case__link" href={localizePath(lang, `/work/${caseSlug(next)}/`)}>
        <span class="eyebrow">{t('case.next')} →</span>
        <span class="next-case__title">{next.data.title}</span>
        <span class="next-case__outcome">{next.data.outcome}</span>
      </a>
    </nav>
  )}

  <FinalCTA lang={lang} title={t('case.ctaTitle')} />
</BaseLayout>

<style>
  .case__header {
    display: grid;
    gap: var(--space-7);
    padding-top: var(--space-8);
  }

  .case__intro {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .case__back {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-touch);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .case__title {
    font-size: var(--text-4xl);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
  }

  .case__summary {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .case__cover {
    width: 100%;
    aspect-ratio: var(--ratio-cover);
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .case__meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
    padding-bottom: var(--space-6);
    border-bottom: var(--border-width) solid var(--color-border);
    font-size: var(--text-sm);
  }

  .case__meta dt {
    margin-bottom: var(--space-1);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .case__meta dd {
    margin: 0;
  }

  .case__outcome {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-7);
    padding-block: var(--space-6);
    border-block: var(--border-width) solid var(--color-border-strong);
  }

  .case__outcome-value {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-3xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-accent);
  }

  .case__repo {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .gallery {
    padding-bottom: var(--space-8);
  }

  .gallery__title {
    margin-bottom: var(--space-6);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border-strong);
    font-size: var(--text-3xl);
  }

  .gallery__grid {
    display: grid;
    gap: var(--space-5);
  }

  .gallery__item img {
    width: 100%;
    height: auto;
    aspect-ratio: var(--ratio-cover);
    object-fit: cover;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 48rem) {
    .gallery__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery__item--wide {
      grid-column: 1 / -1;
    }
  }

  /* MDX body */
  .prose {
    padding-block: var(--space-7) var(--space-8);
  }

  .prose {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .prose :global(strong) {
    color: var(--color-text);
  }

  .prose :global(h2) {
    margin-top: var(--space-8);
    margin-bottom: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--border-width) solid var(--color-border);
    font-size: var(--text-2xl);
    color: var(--color-text);
  }

  .prose :global(li::marker) {
    color: var(--color-accent);
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin-bottom: var(--space-4);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: var(--space-5);
  }

  .prose :global(li + li) {
    margin-top: var(--space-2);
  }

  .prose :global(strong) {
    font-weight: var(--weight-semibold);
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    padding: 0 var(--space-1);
    background: var(--color-surface);
    border-radius: var(--radius-sm);
  }

  .prose :global(img) {
    margin-block: var(--space-6);
    border-radius: var(--radius-lg);
  }

  .next-case__link {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6);
    color: var(--color-text);
    text-decoration: none;
  }

  .next-case__link:hover {
    color: var(--color-text);
    border-color: var(--color-border-strong);
    box-shadow: var(--shadow-md);
  }

  .next-case__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
  }

  .next-case__outcome {
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
  }

  @media (min-width: 48rem) {
    .case__meta {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
